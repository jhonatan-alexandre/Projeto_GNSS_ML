{
  "schema_version": 1,
  "name": "xie_20260922_pru2_sem_geomagneticos",
  "mode": "derivado",
  "reference": "PRU2 com serie local de 2025 e somente entradas locais; sem indices geomagneticos.",
  "inputs": {
    "data_root": "../Dados",
    "ismr_directories": ["Dados ismr 2024"],
    "space_weather_files": []
  },
  "outputs": {
    "processed_data": "dados_processados",
    "models": "modelos",
    "results": "resultados",
    "external_data": "dados_externos"
  },
  "period": {
    "study_start": "2025-01-01 00:00:00",
    "train_end": "2025-03-10 23:59:59",
    "test_start": "2025-03-12 00:00:00",
    "test_end": "2025-03-12 23:59:59"
  },
  "stations": ["PRU2"],
  "preprocessing": {
    "time_resolution": "30min",
    "forecast_minutes": 30,
    "forecast_horizon_steps": 1,
    "rolling_window_steps": 6,
    "daily_lag_steps": 48,
    "minimum_elevation": 15.0,
    "maximum_elevation": 90.0,
    "minimum_s4": 0.0,
    "maximum_s4": 2.0,
    "minimum_vtec": 0.0,
    "maximum_vtec": 250.0,
    "use_corrected_s4": true,
    "earth_radius_km": 6371.0,
    "ionosphere_height_km": 450.0
  },
  "classification": {
    "target_threshold_s4": 0.5,
    "filter_probability_threshold": 0.75,
    "temporal_folds": 5,
    "temporal_gap": "24h",
    "random_state": 42,
    "features": ["elev", "azim_sin", "azim_cos", "hour_sin", "hour_cos", "month_sin", "month_cos", "S4_mean_3h", "S4_std_3h", "S4_lag_24h"],
    "xgboost": {
      "n_estimators": 150,
      "max_depth": 6,
      "learning_rate": 0.05,
      "scale_pos_weight": 1.0,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    },
    "tune_hyperparameters": true
  },
  "regression": {
    "train_fraction": 0.9375,
    "look_back": 48,
    "piecewise_look_back_days": 15,
    "lstm_units": 31,
    "dropout": 0.2,
    "optimizer": "adam",
    "loss": "mse",
    "epochs": 50,
    "batch_size": 400,
    "early_stopping_patience": 3,
    "space_weather_features": [],
    "architectures": [
      {"id": "M1", "organization": "convencional", "attention": false, "multivariate": false},
      {"id": "M3", "organization": "convencional", "attention": true, "multivariate": false},
      {"id": "M5", "organization": "piecewise", "attention": false, "multivariate": false},
      {"id": "M7", "organization": "piecewise", "attention": true, "multivariate": false}
    ],
    "lstm_layers": 3,
    "learning_rate": 0.0005,
    "learning_rate_candidates": [0.05, 0.005, 0.0005, 0.00005, 0.000005, 0.0000005],
    "output_activation": "leaky_relu",
    "leaky_relu_slope": 0.3
  },
  "validation": {"allow_ismr_gaps": true}
}
